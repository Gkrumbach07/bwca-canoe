{
  "manifest_version": 3,
  "name": "BWCA Canoe GPS Simulator",
  "version": "0.1.0",
  "description": "Makes navigator.geolocation in every tab report the position of your canoe in the BWCA Canoe game.",
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["spoof.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true, "match_about_blank": true },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true }
  ],
  "action": { "default_popup": "popup.html", "default_title": "BWCA Canoe GPS" }
}
