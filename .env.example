# Copy to .env.local (ignored by git) or set in the shell / CI.

# Where the baked map data is fetched from (index.json, tiles/, far/, overview.png). Default: data/ under the
# app's own base path, i.e. public/data in development. Point it at a bucket behind a CDN to ship the full
# 380 MB tile set without putting it in the app's host. Must allow CORS from the app's origin.
# VITE_DATA_URL=https://data.example.com/bwca/v3/

# Path the app is served from. '/' for a root domain, '/<repo>/' for a GitHub Pages project site (the Pages
# workflow sets this itself).
# BASE_PATH=/

# Target of `npm run data:sync` (scripts/data-sync.mjs): an rclone remote path (remote:bucket/prefix) or an
# s3:// URL for the AWS CLI. The prefix should match the path in VITE_DATA_URL.
# DATA_SYNC_DEST=r2:bwca-data/bwca/v3
# DATA_SYNC_TOOL=rclone   # or aws; guessed from the destination when unset
